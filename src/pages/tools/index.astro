---
import Layout from '../../components/Layout.astro';
import { tools } from '../../lib/tools';

const siteUrl = 'https://prounitconverter.com';
const pageUrl = `${siteUrl}/tools`;

const groupOrder = ['Text', 'Color', 'Design', 'Numbers', 'Time', 'Health', 'Developer'] as const;
const grouped = groupOrder
  .map(g => ({ group: g, items: tools.filter(t => t.group === g) }))
  .filter(g => g.items.length > 0);

const faqs = [
  { q: 'Are these tools free?', a: 'Yes — every tool on prounitconverter.com is completely free, with no sign-up and no download. They run entirely in your browser.' },
  { q: 'Do these tools upload my data?', a: 'No. All of these converters process your input locally in your browser using JavaScript. Nothing you type or paste is sent to a server.' },
  { q: 'Do they work on mobile?', a: 'Yes. Every tool is mobile-optimized with large, touch-friendly inputs and works on iOS, Android, and any modern browser.' },
  { q: 'What is the difference between Tools and Converters?', a: 'The Converters section handles unit conversions (length, weight, temperature, currency and more). The Tools section covers everyday utilities like color, text case, timestamps, and Base64 — pick whichever matches your task.' },
];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Free Online Converter Tools',
    itemListElement: tools.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: t.name,
      url: `${siteUrl}/tools/${t.slug}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Layout
  title="Free Online Tools & Converters — Color, Text, Timestamp & More"
  description="A free collection of online converter tools: Hex/RGB color converter, text case converter, aspect ratio, Roman numerals, Unix timestamp, time zones, Base64 and binary. No sign-up."
  canonical={pageUrl}
  schemas={schemas}
  keywords="online tools, free converter tools, color converter, text case converter, timestamp converter, base64, roman numeral converter, aspect ratio calculator"
  ogImage={`${siteUrl}/og/tools.png`}
>
  <nav aria-label="Breadcrumb" class="breadcrumb-bar">
    <div class="container">
      <ol class="breadcrumb-list">
        <li><a href="/">Home</a></li>
        <li aria-hidden="true" class="breadcrumb-sep">›</li>
        <li><span>Tools</span></li>
      </ol>
    </div>
  </nav>

  <section class="tools-hero hero-mesh">
    <div class="container">
      <div class="tools-hero-inner">
        <span class="pill-tag pill-tag-soft">Free · No sign-up · Runs in your browser</span>
        <h1 class="display-lg">Free Online Tools &amp; Converters</h1>
        <p class="body-lg" style="color:var(--color-ink-2);max-width:560px;">
          A growing set of handy converters — color, text, time, numbers and developer utilities.
          Fast, private, and free, alongside our unit converters.
        </p>
      </div>
    </div>
  </section>

  <!-- Recently used (client-rendered from localStorage) -->
  <section class="section-sm" id="recent-tools-section" hidden>
    <div class="container">
      <h2 class="heading-md" style="margin-bottom: var(--sp-lg);">Recently used</h2>
      <div class="tools-grid" id="recent-tools-grid"></div>
    </div>
  </section>

  {grouped.map(section => (
    <section class="section-sm">
      <div class="container">
        <h2 class="heading-md" style="margin-bottom: var(--sp-lg);">{section.group}</h2>
        <div class="tools-grid">
          {section.items.map(t => (
            <a href={`/tools/${t.slug}`} class="tool-card card">
              <span class="tool-card-icon" aria-hidden="true">{t.icon}</span>
              <span class="tool-card-name">{t.name}</span>
              <span class="tool-card-desc">{t.tagline}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section-sm">
    <div class="container">
      <div class="tools-cross card-soft" style="padding: var(--sp-xl);">
        <h2 class="heading-sm" style="margin-bottom: 6px;">Looking for unit conversions?</h2>
        <p class="body-md" style="color: var(--color-ink-mute); margin-bottom: var(--sp-md);">
          Convert length, weight, temperature, currency and more with our unit converters.
        </p>
        <a href="/" class="btn btn-secondary btn-sm">Browse all converters →</a>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--color-canvas-soft); border-top: 1px solid var(--color-hairline);">
    <div class="container content-narrow">
      <h2 class="display-md" style="margin-bottom: var(--sp-xxl);">Tools FAQ</h2>
      <div class="faq-list">
        {faqs.map((faq, i) => (
          <div class="faq-item" id={`tools-faq-${i}`}>
            <button class="faq-question" aria-expanded="false" aria-controls={`tools-faq-answer-${i}`}>
              {faq.q}
              <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </button>
            <div class="faq-answer" id={`tools-faq-answer-${i}`} role="region"><p>{faq.a}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .tools-hero { padding: var(--sp-huge) 0 var(--sp-xxl); }
  .tools-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-md);
    max-width: 640px;
  }
  .content-narrow { max-width: 760px; }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-lg);
  }
  @media (max-width: 820px) { .tools-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .tools-grid { grid-template-columns: 1fr; } }

  .tool-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--sp-lg);
    text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .tool-card:hover {
    text-decoration: none;
    border-color: var(--color-primary-subtle);
    box-shadow: var(--shadow-2);
    transform: translateY(-2px);
  }
  .tool-card-icon { font-size: 26px; line-height: 1; margin-bottom: 4px; }
  .tool-card-name { font-size: 15px; font-weight: 600; color: var(--color-ink); }
  .tool-card-desc { font-size: 13px; color: var(--color-ink-mute); line-height: 1.5; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item')!;
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item.open').forEach(el => {
        el.classList.remove('open');
        el.querySelector('.faq-question')?.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) { item.classList.add('open'); btn.setAttribute('aria-expanded', 'true'); }
    });
  });

  // Recently used tools — read from localStorage (written by ToolLayout on each visit)
  (function renderRecent() {
    const section = document.getElementById('recent-tools-section');
    const grid = document.getElementById('recent-tools-grid');
    if (!section || !grid) return;
    let list: Array<{ slug: string; name: string; icon: string }> = [];
    try { list = JSON.parse(localStorage.getItem('uc_recent_tools') || '[]'); } catch {}
    list = list.filter(t => t && typeof t.slug === 'string' && /^[a-z0-9-]+$/.test(t.slug));
    if (!list.length) return;
    section.removeAttribute('hidden');
    for (const t of list.slice(0, 6)) {
      const a = document.createElement('a');
      a.href = `/tools/${t.slug}`;
      a.className = 'tool-card card';
      const icon = document.createElement('span');
      icon.className = 'tool-card-icon';
      icon.setAttribute('aria-hidden', 'true');
      icon.textContent = t.icon || '🧰';
      const name = document.createElement('span');
      name.className = 'tool-card-name';
      name.textContent = t.name || t.slug;
      a.append(icon, name);
      grid.appendChild(a);
    }
  })();
</script>
